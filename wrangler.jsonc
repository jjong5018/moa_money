{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "moa-money",
  "main": "cloudflare/src/index.ts",
  "compatibility_date": "2026-09-20",
  "assets": {
    "directory": "cloudflare/public",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "TRADING_STATE",
        "class_name": "TradingState"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["TradingState"]
    }
  ],
  "vars": {
    "DEPLOYMENT_LOCKED": "false",
    "TRADING_MODE": "paper",
    "KIS_ACCOUNT_PRODUCT_CD": "01"
  }
}
